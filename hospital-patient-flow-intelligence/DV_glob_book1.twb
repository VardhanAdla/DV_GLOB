    <worksheet name='Dynamic Metric Trend'>
      <table>
        <view>
          <datasources>
            <datasource caption='hospital_patient_flow_tableau' name='federated.0f5x5eg15p0ebi11h64nu08gqzh8' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Select Analysis Metric' datatype='string' name='[Parameter 0607533031030785]' param-domain-type='list' role='measure' type='nominal' value='&quot;Patient Volume&quot;'>
              <calculation class='tableau' formula='&quot;Patient Volume&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0f5x5eg15p0ebi11h64nu08gqzh8'>
            <column caption='Arrival Date' datatype='date' name='[Arrival_Date]' role='dimension' type='ordinal' />
            <column caption='Bottleneck Score' datatype='real' name='[Bottleneck_Score]' role='measure' type='quantitative' />
            <column caption='Dynamic Selected Metric' datatype='real' name='[Calculation_0607533032591362]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 0607533031030785]&#13;&#10;WHEN &apos;Patient Volume&apos; THEN COUNTD([Visit_ID])&#13;&#10;WHEN &apos;Waiting Time&apos; THEN AVG([Wait_Doctor])&#13;&#10;WHEN &apos;Length of Stay&apos; THEN AVG([Length_of_Stay])&#13;&#10;WHEN &apos;Emergency Percentage&apos; THEN [Calculation_0694943175274502] * 100&#13;&#10;WHEN &apos;Capacity Pressure&apos; THEN AVG([Capacity_Pressure])&#13;&#10;WHEN &apos;Department Utilization&apos; THEN AVG([Department_Utilization]) * 100&#13;&#10;WHEN &apos;Bottleneck Score&apos; THEN AVG([Bottleneck_Score])&#13;&#10;END' />
            </column>
            <column caption='Emergency Percentage' datatype='real' default-format='p0.0%' name='[Calculation_0694943175274502]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([Emergency_Flag] = &apos;Yes&apos;, 1, 0))&#13;&#10;/&#13;&#10;COUNTD([Visit_ID])' />
            </column>
            <column caption='Capacity Pressure' datatype='real' name='[Capacity_Pressure]' role='measure' type='quantitative' />
            <column datatype='string' name='[Department]' role='dimension' type='nominal' />
            <column caption='Department Utilization' datatype='real' name='[Department_Utilization]' role='measure' type='quantitative' />
            <column caption='Emergency Flag' datatype='string' name='[Emergency_Flag]' role='dimension' type='nominal' />
            <column caption='Length of Stay' datatype='integer' name='[Length_of_Stay]' role='measure' type='quantitative' />
            <column datatype='string' name='[Month]' role='dimension' type='nominal' />
            <column caption='Priority Level' datatype='string' name='[Priority_Level]' role='dimension' type='nominal' />
            <column datatype='string' name='[Shift]' role='dimension' type='nominal' />
            <column caption='Visit ID' datatype='string' name='[Visit_ID]' role='dimension' type='nominal' />
            <column caption='Wait Doctor' datatype='integer' name='[Wait_Doctor]' role='measure' type='quantitative' />
            <column-instance column='[Department]' derivation='None' name='[none:Department:nk]' pivot='key' type='nominal' />
            <column-instance column='[Emergency_Flag]' derivation='None' name='[none:Emergency_Flag:nk]' pivot='key' type='nominal' />
            <column-instance column='[Month]' derivation='None' name='[none:Month:nk]' pivot='key' type='nominal' />
            <column-instance column='[Priority_Level]' derivation='None' name='[none:Priority_Level:nk]' pivot='key' type='nominal' />
            <column-instance column='[Shift]' derivation='None' name='[none:Shift:nk]' pivot='key' type='nominal' />
            <column-instance column='[Arrival_Date]' derivation='Day-Trunc' name='[tdy:Arrival_Date:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_0607533032591362]' derivation='User' name='[usr:Calculation_0607533032591362:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <slices>
            <column>[federated.0f5x5eg15p0ebi11h64nu08gqzh8].[none:Department:nk]</column>
            <column>[federated.0f5x5eg15p0ebi11h64nu08gqzh8].[none:Priority_Level:nk]</column>
            <column>[federated.0f5x5eg15p0ebi11h64nu08gqzh8].[none:Shift:nk]</column>
